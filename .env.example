# AMT LLM 凭据示例 —— 复制为 .env 后填入真实值。
#
# 用法：
#   1. cp .env.example .env
#   2. 填入 base_url / model / 密钥
#   3. amt llm-check        # 先自检连通性
#   4. amt compare --session <id>
#
# 查找顺序：AMT_ENV_FILE → $AMT_HOME/.env → 当前工作目录/.env
# 优先级：命令行参数 > 真实环境变量 > .env 文件 > config.yaml > 内置默认值
#
# 注意：.env 已被 .gitignore 排除，请勿把真实密钥提交到仓库。

# ---- OpenAI 兼容端点（中转站 / 官方 / 本地 vLLM / Ollama 均可）----
# 中转站与官方 API 一般需要带 /v1；Ollama 默认 http://127.0.0.1:11434/v1
AMT_LLM_BASE_URL=http://127.0.0.1:11434/v1

# 模型名必须与端点侧一致（中转站的模型名常与官方不同，写错会返回 400/404）
AMT_LLM_MODEL=qwen2.5-coder:7b

# 本地模型不需要密钥时可留空
AMT_LLM_API_KEY=

# ---- 可选 ----
# 显式开关；省略时「base_url + model + api_key 齐全」会自动启用
# AMT_LLM_ENABLED=true
# 端点较慢（如中转站排队）时可放宽，单位秒
# AMT_LLM_TIMEOUT=300
# 输出预算。思维链模型（Claude / DeepSeek-R 系）会先花大量 token 推理，
# 4096 常常不够、正文会被截断。工具会自动翻倍重试一次，但预设大一些可以省掉这轮。
# AMT_LLM_MAX_TOKENS=8192
